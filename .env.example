# Environment for the MCP server (packages/mcp) and the audit dashboard's runtime inputs.
#
# The MCP server reads these directly from its process environment — supplied by whatever
# launches it (e.g. your Claude Desktop / Claude Code MCP config), not from a .env file.
#
# For testing on Sepolia with the scripts in scripts/, use scripts/.env.example instead — it is
# the file those scripts actually load, prefilled with verified Sepolia addresses.

# Starknet RPC endpoint.
#   devnet : http://127.0.0.1:5050
#   sepolia: e.g. https://starknet-sepolia.public.blastapi.io/rpc/v0_8 or a provider URL
STARKNET_RPC_URL=http://127.0.0.1:5050

# Network selector: devnet | sepolia | mainnet. On devnet the MCP server routes swaps through a
# mock exchange (MOCK_RATE_NUM/DEN); on sepolia/mainnet it routes through the real avnu API.
STARKNET_NETWORK=devnet

# Agent-owner account: signs transactions and controls policy + the viewing key.
AGENT_OWNER_ADDRESS=
AGENT_OWNER_PRIVATE_KEY=

# Deployed PhantomLayer contract addresses (see deployments/<network>.json after a deploy script).
AGENT_REGISTRY_ADDRESS=
POLICY_ENGINE_ADDRESS=
AGENT_SHIELD_ADDRESS=

# avnu exchange router. On devnet this is the mock exchange address from your local deploy.
AVNU_ROUTER_ADDRESS=

# Owner viewing key (hex felt) — decrypts the audit log. Generate with generateViewingKey().
AGENT_VIEWING_KEY=

# Devnet-only: mock exchange rate (out = in * num / den).
MOCK_RATE_NUM=1
MOCK_RATE_DEN=1
