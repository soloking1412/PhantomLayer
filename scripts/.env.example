# Copy to scripts/.env and fill in a funded Starknet Sepolia account.
#   cp scripts/.env.example scripts/.env
# Fund the account with STRK from the faucet: https://starknet-faucet.vercel.app/

# Sepolia RPC. Verified working: zan.top (used below). blastapi.io's free Sepolia endpoint has
# been discontinued; nethermind's and lava's free endpoints were unreliable when last checked —
# get your own key at https://www.starknet.io/fullnodes-rpc-services/ for anything beyond testing.
STARKNET_RPC_URL=https://api.zan.top/public/starknet-sepolia/rpc/v0_10

# Funded deployer account (used by e2e:sepolia and deploy:sepolia).
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Agent-owner account for demo:sepolia (can be the same as the deployer). Must hold DEMO_TOKEN_IN.
AGENT_OWNER_ADDRESS=
AGENT_OWNER_PRIVATE_KEY=

# --- Real-avnu deploy (deploy:sepolia) ---
# Verified live avnu Sepolia exchange and a STRK -> ETH pair with liquidity.
AVNU_ROUTER_ADDRESS=0x2c56e8b00dbe2a71e57472685378fc8988bba947e9a99b26a00fade2b4fe7c2
AVNU_BASE_URL=https://sepolia.api.avnu.fi
DEMO_TOKEN_IN=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
DEMO_TOKEN_OUT=0x049d36570d4e46f48e99674bd3fcc84644ddd6b96f7c741b1562b82f9e004dc7
DEMO_AMOUNT_IN=100000000000000000
DEMO_SLIPPAGE_BPS=50

# --- Real confidential demo (demo:sepolia) ---
# Deployed Tongo pool for DEMO_TOKEN_IN, and the agent's Tongo private key (generate once).
TONGO_ADDRESS=
TONGO_PRIVATE_KEY=
# Optional: Tongo pool for DEMO_TOKEN_OUT, to auto re-shield the swap output.
TONGO_OUT_ADDRESS=

# Protocol fee on each shielded execution (basis points).
PHANTOM_FEE_BPS=5
